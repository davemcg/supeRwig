Package: supeRwig
Title: Interactive BigWig Coverage Viewer for SummarizedExperiment Cohorts
Version: 0.2.4
Authors@R: person("David", "McGaughey", email = "mcgaughey@gmail.com",
                  role = c("aut", "cre"))
Description: A Shiny app for browsing per-sample BigWig coverage across
    large cohorts. Sample metadata and CPM-based filtering come from an
    HDF5-backed SummarizedExperiment; gene/transcript/exon annotation
    comes from a pre-compiled fst table. Parallel BigWig reads use
    BiocParallel.
License: MIT + file LICENSE
Encoding: UTF-8
Roxygen: list(markdown = TRUE)
Depends:
    R (>= 4.1)
Imports:
    shiny (>= 1.6),
    bslib,
    data.table,
    fst,
    ggplot2,
    cowplot,
    colourpicker,
    ggnewscale,
    ggforce,
    GenomicRanges,
    IRanges,
    rtracklayer,
    BiocParallel,
    rtracklayer,
    ggiraph,
    SummarizedExperiment,
    HDF5Array,
    pals,
    parallel,
    utils
Config/roxygen2/version: 8.0.0
